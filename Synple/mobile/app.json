{
  "expo": {
    "name": "Synple",
    "slug": "synple",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/synple-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/synple-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4B43CF",
        "foregroundImage": "./assets/synple-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
