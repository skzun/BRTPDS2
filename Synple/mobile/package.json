{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "^58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-local-authentication": "~58.0.2",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "node scripts/detect-ip.js && expo start --dev-client",
    "start:go": "node scripts/detect-ip.js && expo start --go",
    "start:tunnel:go": "expo start --tunnel --go",
    "start:dev-client": "node scripts/detect-ip.js && expo start --dev-client",
    "start:tunnel:dev-client": "expo start --tunnel --dev-client",
    "tunnel": "node ../scripts/dev-tunnel.js",
    "tunnel:go": "node ../scripts/dev-tunnel.js --go",
    "android": "node scripts/detect-ip.js && expo start --android",
    "ios": "node scripts/detect-ip.js && expo start --ios",
    "web": "node scripts/detect-ip.js && expo start --web",
    "detect-ip": "node scripts/detect-ip.js",
    "test": "node --test test/*.test.js"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
}
