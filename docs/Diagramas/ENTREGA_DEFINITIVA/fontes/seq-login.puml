@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #334155
skinparam roundcorner 5
skinparam dpi 130
skinparam sequenceMessageAlign left
hide footbox
autonumber
title SQ02 — entrar com senha ou Google e abrir sessão (RF19, RF20)
actor Visitante as V
participant "LoginScreen.js" as UI
participant "App.js" as App
participant "services/api.js" as Api
participant "services/session.js" as Ses
participant "routes/auth.js" as Auth
participant "services/security.js" as Sec
participant "GoogleSignin" as G
database "PostgreSQL" as DB
alt e-mail e senha
 V -> UI : onPress("Entrar")
 UI -> App : login({email, password})
 App -> App : validateLogin({email, password})
 App -> Api : loginWithApi(email, password)
 Api -> Auth : POST /api/auth/login
 Auth -> DB : query("SELECT * FROM users WHERE LOWER(email) = $1")
 Auth -> Auth : bcrypt.compare(password, password_hash)
 Auth -> Auth : user.email_verified ? continua : 403
else Google
 V -> UI : onPress("Entrar com Google")
 UI -> G : GoogleSignin.signIn()
 G --> UI : idToken
 UI -> App : loginWithGoogle(idToken)
 App -> Api : loginWithGoogleApi(idToken)
 Api -> Auth : POST /api/auth/google
 Auth -> Auth : googleOAuthClient.verifyIdToken({idToken, audience})
 Auth -> DB : query("UPDATE users SET google_id ... | INSERT INTO users ...")
end
Auth -> Sec : issueSession(userId)
Sec -> DB : query("INSERT INTO auth_sessions (token_hash, user_id, expires_at)")
Sec --> Auth : token
Auth --> Api : 200 {token, perfil}
Api -> Ses : rememberSession(token)
Ses -> Ses : SecureStore.setItemAsync(KEY, token, {requireAuthentication})
Api --> App : {success, user}
App -> App : finishLogin(user)
App -> App : syncWithRemote()
@enduml
