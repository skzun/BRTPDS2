@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 13
title Presença própria, por código e por gestor
autonumber
actor "Usuário autenticado" as U
participant "App / API cliente" as App
participant "routes/meetings.js" as API
database PostgreSQL as DB
U -> App: confirmBiometric() ou código informado
App -> API: PATCH /meetings/:meetingId/attendance[/:participantId]
API -> API: getMeeting(client, meetingId, userId)
API -> API: requireOngoing(meeting)
opt registro por terceiro
 API -> API: requireManager(meetingDoAtor)
end
opt código informado
 API -> DB: query("SELECT 1 FROM meeting_attendance_codes WHERE ...", params)
end
API -> DB: query("SELECT 1 FROM meeting_invitations ...", params)
alt entrada
 API -> DB: query("INSERT INTO meeting_attendance ...", params)
else saída
 API -> DB: query("UPDATE meeting_attendance SET left_at=...", params)
end
API --> App: 200 presença / 403 acesso / 409 período ou estado
@enduml
