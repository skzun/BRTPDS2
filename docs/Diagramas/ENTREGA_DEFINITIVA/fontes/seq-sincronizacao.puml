@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #334155
skinparam roundcorner 5
skinparam dpi 130
skinparam sequenceMessageAlign left
hide footbox
autonumber
title SQ05 — sincronizar dados e manter cache sem credenciais (RF25)
actor "Usuário autenticado" as U
participant "App.js" as App
participant "hooks/useSynpleData.js" as Hook
participant "services/api.js" as Api
participant "services/security.js" as Sec
participant "routes/sync.js" as R
database "PostgreSQL" as DB
participant "services/storage.js" as St
U -> App : refreshData()
App -> Hook : syncWithRemote()
Hook -> Hook : getSessionToken()
Hook -> Api : fetchRemoteData()
Api -> Sec : GET /api/sync (Authorization: Bearer)
Sec -> DB : query("SELECT ... FROM auth_sessions JOIN users ... expires_at > NOW()")
Sec -> R : authenticate() → next()
R -> DB : query("SELECT ... FROM users | organizations | ... | meeting_votes")
R -> Sec : scopeSnapshot(snapshot, req.auth)
Sec --> R : snapshot filtrado
R --> Api : 200 snapshot
alt API indisponível
 Api --> Hook : null
 Hook -> Hook : setDbStatus("OFFLINE")
else sucesso
 Api --> Hook : remote
 Hook -> Hook : setData(removeCredentials({...EMPTY_DATA, ...remote}))
 Hook -> St : saveData(data)
 St -> St : AsyncStorage.setItem("@synple:incremento-1", JSON.stringify(removeCredentials(data)))
end
@enduml
