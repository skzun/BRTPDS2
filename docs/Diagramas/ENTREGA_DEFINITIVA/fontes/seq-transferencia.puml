alt não é o proprietário
 R -> DB : query("ROLLBACK")
 R --> Api : 403 {error}
else novo dono sem vínculo APPROVED
 R -> DB : query("ROLLBACK")
 R --> Api : 400 {error}
else válido
 R -> DB : query("INSERT INTO access_requests ... (antigo dono como MEMBER) ON CONFLICT DO UPDATE")
 R -> DB : query("UPDATE organizations SET owner_id = $1 WHERE id = $2")
 R -> DB : query("COMMIT")
