@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #334155
skinparam roundcorner 5
skinparam dpi 130
left to right direction
title Casos de uso — Incremento 3: ata, votação, relatório e manual
actor "Presidente da comissão\n(coordenador ou proprietário)" as G
actor "Usuário autenticado" as U
actor "Participante da reunião\n(entrada registrada)" as P
U <|-- G
U <|-- P
rectangle "Synple" {
  usecase "RF02.07\nCriar ou corrigir ata" as ATA
  usecase "RF02.08\nSubmeter ata\npara aprovação" as SUB
  usecase "RF03.01\nAbrir votação" as V1
  usecase "RF03.03\nEncerrar votação" as V3
  usecase "RF02.10\nGerar PDF da ata" as PDF
  usecase "RF03.04\nConsultar relatório\nindividual de participação" as REL
  usecase "RF03.05\nConsultar manual\nde utilização" as MAN
  usecase "RF02.09\nAprovar ou\nreprovar ata" as DEC
  usecase "RF03.02\nVotar ou\nalterar voto" as V2
  usecase "Verificar entrada\nregistrada na reunião" as CHK
}
G -- ATA
G -- SUB
G -- V1
G -- V3
U -- PDF
U -- REL
U -- MAN
P -- DEC
P -- V2
SUB ..> CHK : <<include>>
V1 ..> CHK : <<include>>
DEC ..> CHK : <<include>>
V2 ..> CHK : <<include>>
PDF ..> ATA : <<extend>>
@enduml
