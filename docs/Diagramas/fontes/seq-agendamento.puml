@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 13
title Agendar reunião e responder convite
autonumber
actor "Usuário autenticado" as U
participant "App / API cliente" as App
participant "routes/meetings.js" as API
database PostgreSQL as DB
U -> App: buildMeetingPayload(form, commissionId, inviteeIds)
App -> API: POST /meetings
API -> API: validateSchedule(req.body)
API -> DB: query("SELECT c.id ... FOR UPDATE OF c", params)
API -> DB: query("INSERT INTO meetings ...", params)
API -> DB: query("INSERT INTO meeting_invitations ...", params)
API --> App: 201 reunião e convites
U -> App: respondToMeetingInvitationWithApi(meetingId, userId, status)
App -> API: PATCH /meetings/:meetingId/invitation
API -> API: getMeeting(client, meetingId, userId)
API -> DB: query("UPDATE meeting_invitations SET status=...", params)
API --> App: 200 convite ou 409 prazo
@enduml
